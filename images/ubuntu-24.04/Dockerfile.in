# ubuntu-24.04: the Zode base image (Ubuntu 24.04 LTS) as a named line, so a
# sandbox can ask for `zode/ubuntu-24.04` next to `zode/debian-13`,
# `zode/fedora-45`, `zode/arch` and `zode/alpine-3.24` (REQ-084). It adds
# nothing but the week's security updates and the software report; old size
# names (small-v8, ...) resolve to this line (REQ-081).
#
# FROM zode: each RUN runs in the build VM with `bash -lc` as root. COPY and
# ADD are refused, so everything is inline.
FROM zode

# Set by the publish workflow to the release version (YYYYMMDD.run).
ARG IMAGE_VERSION=dev

ENV ZODE_IMAGE_VERSION=${IMAGE_VERSION}

# Security updates since the base was built (the node's mirror serves
# noble-security). The weekly refresh workflow can republish this line so
# it never runs more than a week behind.
RUN <<'ZODE_STEP'
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive
for i in 1 2 3 4 5; do apt-get update && break; sleep $((i * 10)); done
apt-get -y -o Dpkg::Options::=--force-confold upgrade
apt-get clean
rm -rf /var/lib/apt/lists/*
ZODE_STEP

@SOFTWARE_REPORT_STEP@

# Last step: print the software manifest (one ZODE-MANIFEST line).
RUN /usr/local/bin/zode-software-report

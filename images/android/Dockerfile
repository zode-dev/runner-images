# Generated by scripts/render.sh from images/android/Dockerfile.in. Edit that file, not this one.
# android: AOSP for x86_64 in a container (redroid) on the Zode base, its
# screen on the sandbox's desktop (`zode new --image zode/android --desktop`).
# zode-dev/zoded docs/android.md has the design and the contract.
#
# The one setup step is images/android/setup.sh, inlined by scripts/render.sh
# (Zode refuses COPY and ADD). The same script builds the image as a growable
# golden with zoded's deploy/node/make-base.sh EXTRA=.
FROM zode

# Set by the publish workflow to the release version (YYYYMMDD.run).
ARG IMAGE_VERSION=dev

ENV ZODE_IMAGE_VERSION=${IMAGE_VERSION}

# setup.sh, inlined by scripts/render.sh. It loads the binder module and mounts
# binderfs: this is a VM, not a container.
# hadolint ignore=DL3001
RUN <<'ZODE_STEP'
#!/usr/bin/env bash
# zode/android: AOSP for x86_64 in a container (redroid), on the Zode base.
# Runs as root in the build VM (the Dockerfile inlines it as one step;
# zoded's make-base.sh EXTRA= runs it after provision.sh for a growable base).
# zoded docs/android.md has the design and the contract.
#
# Leaves behind:
#   - binder_linux.ko for the running kernel, loaded at boot (the kernel
#     variant: only this image has it), binderfs on /dev/binderfs
#   - adb (Ubuntu's, built from AOSP source) and scrcpy (Apache-2.0)
#   - Docker container zode-android: redroid pinned by digest, booted,
#     unlocked, awake, animations off
#   - /etc/zode/android.json: what zode-desktop reads to serve the phone
#   - the desktop switched on, so the image is frozen with the screen up
set -euxo pipefail

# Android 15 (redroid 15.0.0-250627, x86_64 + x86). Android 16 (16.0.0-250627,
# sha256:d89f5204...) was tried on 17 Nov 2026 and does not boot with software
# rendering: SurfaceFlinger aborts in primeShaderCache ("output buffer not gpu
# writeable") and the system server loops. Revisit with the next redroid 16.
REDROID_TAG="${REDROID_TAG:-15.0.0-250627}"
REDROID_DIGEST="${REDROID_DIGEST:-sha256:81889852444606824d33eb0232fa5813bce3f0993afe871785120af0d7c991ad}"
SCRCPY_VERSION="${SCRCPY_VERSION:-5.0.1}"
SCRCPY_SHA256="${SCRCPY_SHA256:-9f969d30cc574816077edecda65719c1c70b0aee1df1ba5fa00779ac07b8fd6e}"
WIDTH=720 HEIGHT=1280 DPI=320
SERIAL=127.0.0.1:5555

retry() { local i; for i in 1 2 3 4 5 6; do "$@" && return 0; sleep $((i * 5)); done; return 1; }

# --- 1. Kernel variant: binder + binderfs -------------------------------------
KVER=$(uname -r)
grep -E 'CONFIG_ANDROID_BINDER(_IPC|FS|_DEVICES)=' "/boot/config-$KVER" || true
if ! modinfo binder_linux >/dev/null 2>&1; then
  retry apt-get update
  tmp=$(mktemp -d)
  (cd "$tmp" && retry apt-get download "linux-modules-extra-$KVER")
  dpkg-deb -x "$tmp"/linux-modules-extra-*.deb "$tmp/x"
  ko=$(find "$tmp/x" -name 'binder_linux.ko*' | head -1)
  [ -n "$ko" ] || { echo "linux-modules-extra-$KVER has no binder_linux"; exit 1; }
  install -D -m0644 "$ko" "/lib/modules/$KVER/updates/zode/$(basename "$ko")"
  rm -rf "$tmp"
  depmod -a "$KVER"
fi
echo binder_linux > /etc/modules-load.d/zode-android.conf
echo 'options binder_linux devices=binder,hwbinder,vndbinder' > /etc/modprobe.d/zode-android.conf
modprobe binder_linux devices=binder,hwbinder,vndbinder
mkdir -p /dev/binderfs
grep -q ' /dev/binderfs ' /proc/mounts || mount -t binder binder /dev/binderfs
cat > /etc/systemd/system/dev-binderfs.mount <<'UNIT'
[Unit]
Description=binderfs for Android (zode/android)
After=systemd-modules-load.service
Before=docker.service
[Mount]
What=binder
Where=/dev/binderfs
Type=binder
[Install]
WantedBy=local-fs.target
UNIT
systemctl daemon-reload
systemctl enable dev-binderfs.mount
ls -l /dev/binderfs

# --- 2. adb and scrcpy -------------------------------------------------------
retry apt-get update
DEBIAN_FRONTEND=noninteractive retry apt-get install -y --no-install-recommends adb x11-utils
curl -fsSL --retry 6 --retry-delay 5 --retry-all-errors --connect-timeout 20 -o /tmp/scrcpy.tgz \
  "https://github.com/Genymobile/scrcpy/releases/download/v${SCRCPY_VERSION}/scrcpy-linux-x86_64-v${SCRCPY_VERSION}.tar.gz"
echo "$SCRCPY_SHA256  /tmp/scrcpy.tgz" | sha256sum -c -
rm -rf /opt/scrcpy && mkdir -p /opt/scrcpy
tar -xzf /tmp/scrcpy.tgz -C /opt/scrcpy --strip-components=1
rm -f /tmp/scrcpy.tgz /opt/scrcpy/adb   # Ubuntu's adb, not Google's platform-tools binary
cat > /usr/local/bin/scrcpy <<'SH'
#!/bin/sh
export ADB=/usr/bin/adb SCRCPY_SERVER_PATH=/opt/scrcpy/scrcpy-server
exec /opt/scrcpy/scrcpy_bin "$@"
SH
[ -x /opt/scrcpy/scrcpy_bin ] || mv /opt/scrcpy/scrcpy /opt/scrcpy/scrcpy_bin
chmod 0755 /usr/local/bin/scrcpy
scrcpy --version

# --- 3. Android ---------------------------------------------------------------
systemctl enable --now docker
retry docker pull -q "redroid/redroid:${REDROID_TAG}@${REDROID_DIGEST}"
docker rm -f zode-android 2>/dev/null || true
docker run -d --name zode-android --restart unless-stopped --privileged \
  -p 127.0.0.1:5555:5555 -v zode-android-data:/data \
  "redroid/redroid:${REDROID_TAG}@${REDROID_DIGEST}" \
  androidboot.redroid_width=$WIDTH androidboot.redroid_height=$HEIGHT \
  androidboot.redroid_dpi=$DPI androidboot.redroid_fps=30 \
  androidboot.redroid_gpu_mode=guest androidboot.use_memfd=true \
  ro.product.cpu.abilist=x86_64,x86 ro.product.cpu.abilist64=x86_64 ro.product.cpu.abilist32=x86 \
  ro.vendor.product.cpu.abilist=x86_64,x86 ro.vendor.product.cpu.abilist64=x86_64 ro.vendor.product.cpu.abilist32=x86 \
  ro.dalvik.vm.native.bridge=0 ro.enable.native.bridge.exec=0
# The image announces ARM ABIs through a native-bridge stub (libnb.so) but
# ships no translation library; the properties above make Android itself
# refuse ARM-only apps instead of installing apps that cannot start.

booted=0
for i in $(seq 1 180); do
  adb connect "$SERIAL" >/dev/null 2>&1 || true
  if [ "$(adb -s "$SERIAL" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; then booted=1; break; fi
  sleep 2
done
if [ "$booted" != 1 ]; then docker logs --tail 80 zode-android || true; dmesg | tail -40; echo "Android did not boot"; exit 1; fi
sh_() { adb -s "$SERIAL" shell "$@"; }
# Agents and screenshots want a still, awake, unlocked phone.
sh_ settings put global window_animation_scale 0
sh_ settings put global transition_animation_scale 0
sh_ settings put global animator_duration_scale 0
sh_ settings put system screen_off_timeout 2147483647
sh_ settings put global stay_on_while_plugged_in 7
sh_ settings put system accelerometer_rotation 0
sh_ wm fixed-to-user-rotation enabled   # rotate turns every app, the launcher too
sh_ settings put system user_rotation 0
sh_ locksettings set-disabled true || true
sh_ svc power stayon true || true
sh_ input keyevent KEYCODE_WAKEUP
sh_ wm dismiss-keyguard || true
sh_ input keyevent KEYCODE_HOME
RELEASE=$(sh_ getprop ro.build.version.release | tr -d '\r')
SDK=$(sh_ getprop ro.build.version.sdk | tr -d '\r')
ABIS=$(sh_ getprop ro.product.cpu.abilist | tr -d '\r')

install -d /etc/zode
cat > /etc/zode/android.json <<JSON
{"serial":"$SERIAL","container":"zode-android","width":$WIDTH,"height":$HEIGHT,"density":$DPI,
 "release":"$RELEASE","sdk":$SDK,"abis":"$ABIS","redroid":"redroid/redroid:${REDROID_TAG}@${REDROID_DIGEST}",
 "scrcpy":"$SCRCPY_VERSION"}
JSON
cat /etc/zode/android.json

install -d /usr/share/doc/zode-android
cat > /usr/share/doc/zode-android/NOTICE <<NOTICE
zode/android ships:
- redroid/redroid:${REDROID_TAG}@${REDROID_DIGEST}: AOSP $RELEASE for x86_64/x86
  built for containers (https://github.com/remote-android/redroid-doc), Apache-2.0
  with the licences of the AOSP components it contains. No Google apps, no Google
  Play, no ARM translation.
- scrcpy $SCRCPY_VERSION (https://github.com/Genymobile/scrcpy), Apache-2.0; its
  static build links FFmpeg (LGPL-2.1-or-later) and SDL (zlib).
- adb from Ubuntu's adb package (AOSP source, Apache-2.0).
- binder_linux.ko from Ubuntu's linux-modules-extra-$KVER, GPL-2.0.
NOTICE

# --- 4. The screen up before the freeze ---------------------------------------
# zode-desktop serves the phone when /etc/zode/android.json exists; switching
# the desktop on here keeps Xvfb, scrcpy and voxl running in the snapshot.
if [ -x /usr/local/lib/zode/zode-desktop ]; then
  /usr/local/lib/zode/zode-desktop enable desktop
  /usr/local/lib/zode/zode-desktop android status
fi
# Warm the pages a new sandbox touches first.
cat /opt/scrcpy/* /usr/bin/adb >/dev/null 2>&1 || true
ZODE_STEP

# The software report (scripts/software-report.sh), installed as
# /usr/local/bin/zode-software-report.
RUN <<'ZODE_STEP'
set -euo pipefail
cat > /usr/local/bin/zode-software-report <<'ZODE_SOFTWARE_REPORT'
#!/usr/bin/env bash
# Prints the software in this image as one line:
#   ZODE-MANIFEST {"os":"...","groups":[...],"env":{...}}
# The control plane stores that JSON on the release (docs/official-images.md
# in zode-dev/zoded). A tool that is not installed is left out, never an error.
#
# Single source: scripts/render.sh copies this file into every Dockerfile,
# which installs it as /usr/local/bin/zode-software-report.
set -uo pipefail

TOOL_CACHE=${RUNNER_TOOL_CACHE:-${AGENT_TOOLSDIRECTORY:-/opt/hostedtoolcache}}
# rustup lives in CARGO_HOME (GitHub's layout); report the toolchain it runs.
if [ -n "${CARGO_HOME:-}" ] && [ -d "$CARGO_HOME/bin" ]; then PATH="$CARGO_HOME/bin:$PATH"; fi
ROWS=$(mktemp)
trap 'rm -f "$ROWS"' EXIT

have() { command -v "$1" >/dev/null 2>&1; }

# run CMD...: the command's output, with a time limit when timeout exists.
run() {
  if have timeout; then timeout 20 "$@" 2>&1; else "$@" 2>&1; fi
}

# num: the first dotted version number in the input (1.2 or 1.2.3...).
num() { grep -oE '[0-9]+(\.[0-9]+)+' | head -n1; }

# add GROUP NAME VERSION: one row; an empty version is skipped.
add() {
  [ -n "${3:-}" ] || return 0
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >>"$ROWS"
}

# tool GROUP NAME BINARY [ARGS...]: version of BINARY when it is on PATH.
tool() {
  local group=$1 name=$2 bin=$3
  shift 3
  have "$bin" || return 0
  add "$group" "$name" "$(run "$bin" "$@" | num)"
}

# service UNIT: ", running" or ", stopped" for a systemd unit.
service() {
  have systemctl || return 0
  if systemctl is-active --quiet "$1" 2>/dev/null; then
    printf ', running'
  else
    printf ', stopped'
  fi
}

# Operating system.
OS=unknown
if [ -r /etc/os-release ]; then
  # shellcheck disable=SC1091
  OS=$(. /etc/os-release && printf '%s' "${PRETTY_NAME:-$NAME}")
elif have sw_vers; then
  OS="macOS $(sw_vers -productVersion)"
fi
G="Operating system"
add "$G" "OS" "$OS"
add "$G" "Kernel" "$(uname -r)"
if have dpkg-query && dpkg-query -W systemd >/dev/null 2>&1; then
  add "$G" "systemd" "$(dpkg-query -W -f='${Version}' systemd)"
else
  have systemctl && add "$G" "systemd" "$(run systemctl --version | head -n1 | grep -oE '[0-9]+(\.[0-9]+)*' | head -n1)"
fi

# Languages and runtimes.
G="Languages and runtimes"
tool "$G" "Bash" bash --version
have dpkg-query && add "$G" "Dash" "$(dpkg-query -W -f='${Version}' dash 2>/dev/null)"
have gcc && add "$G" "GCC" "$(run gcc -dumpfullversion | num)"
have gfortran && add "$G" "GNU Fortran" "$(run gfortran -dumpfullversion | num)"
tool "$G" "Clang" clang --version
tool "$G" "Clang-format" clang-format --version
tool "$G" "Clang-tidy" clang-tidy --version
tool "$G" "Go" go version
java_list=""
for var in $(env | grep -oE '^JAVA_HOME_[0-9]+_X64' | sort -t_ -k3 -n); do
  dir=${!var}
  [ -x "$dir/bin/java" ] || continue
  # SEMANTIC_VERSION says 8.0.512+9 where Java 8 itself says 1.8.0_512.
  v=$(grep -E '^SEMANTIC_VERSION=' "$dir/release" 2>/dev/null | cut -d'"' -f2)
  [ -n "$v" ] || v=$(grep -E '^JAVA_RUNTIME_VERSION=' "$dir/release" 2>/dev/null | cut -d'"' -f2)
  [ -n "$v" ] || v=$(run "$dir/bin/java" -version | num)
  v=${v%-LTS}
  [ "$(readlink -f "$dir")" = "$(readlink -f "${JAVA_HOME:-/nonexistent}")" ] && v="$v (default)"
  java_list="${java_list:+$java_list, }$v"
done
if [ -n "$java_list" ]; then
  add "$G" "Java" "$java_list"
else
  tool "$G" "Java" java -version
fi
tool "$G" "Node.js" node --version
tool "$G" "Perl" perl -e 'print $^V'
tool "$G" "PowerShell" pwsh --version
tool "$G" "Python" python3 --version
tool "$G" "Ruby" ruby --version
tool "$G" "Rust" rustc --version
tool "$G" "Rustdoc" rustdoc --version
tool "$G" "Rustfmt" rustfmt --version

# Package managers.
G="Package managers"
tool "$G" "npm" npm --version
tool "$G" "pnpm" pnpm --version
tool "$G" "Yarn" yarn --version
tool "$G" "Bun" bun --version
tool "$G" "pip" pip3 --version
tool "$G" "pipx" pipx --version
tool "$G" "RubyGems" gem --version
tool "$G" "Cargo" cargo --version
tool "$G" "Rustup" rustup --version

# Build tools.
G="Build tools"
tool "$G" "CMake" cmake --version
tool "$G" "Ninja" ninja --version
tool "$G" "Maven" mvn -v
tool "$G" "Gradle" gradle --version
tool "$G" "Ant" ant -version
# Bazelisk prints its own version, then runs Bazel: hand it /bin/true as
# Bazel so it downloads nothing.
have bazelisk && add "$G" "Bazelisk" "$(HOME=${HOME:-/tmp} USE_BAZEL_VERSION=/bin/true run bazelisk version |
  grep -i '^bazelisk' | num)"

# Containers.
G="Containers"
if have docker; then
  add "$G" "Docker client" "$(run docker version --format '{{.Client.Version}}' | num)"
  add "$G" "Docker server" "$(run docker version --format '{{.Server.Version}}' | num)"
  add "$G" "Docker Buildx" "$(run docker buildx version | num)"
  add "$G" "Docker Compose" "$(run docker compose version --short | num)"
fi
tool "$G" "Podman" podman --version
tool "$G" "Buildah" buildah --version
tool "$G" "Skopeo" skopeo --version
tool "$G" "Kind" kind version

# Cloud and deploy CLIs.
G="Cloud and deploy CLIs"
tool "$G" "AWS CLI" aws --version
tool "$G" "AWS CLI Session Manager Plugin" session-manager-plugin --version
have az && add "$G" "Azure CLI" "$(run az version --query '"azure-cli"' --output tsv | num)"
tool "$G" "Google Cloud CLI" gcloud --version
tool "$G" "kubectl" kubectl version --client
tool "$G" "Helm" helm version --short
tool "$G" "Kustomize" kustomize version

# Tools.
G="Tools"
tool "$G" "Git" git --version
tool "$G" "Git LFS" git-lfs --version
tool "$G" "GitHub CLI" gh --version
if [ -r /opt/zode-runner/.version ]; then
  add "$G" "GitHub Actions runner" "$(num </opt/zode-runner/.version)"
fi
tool "$G" "jq" jq --version
tool "$G" "yq" yq --version
tool "$G" "zstd" zstd --version
tool "$G" "rsync" rsync --version
tool "$G" "OpenSSH" ssh -V
tool "$G" "OpenSSL" openssl version
tool "$G" "curl" curl --version
tool "$G" "Mercurial" hg --version
tool "$G" "MediaInfo" mediainfo --version
tool "$G" "ShellCheck" shellcheck --version
tool "$G" "yamllint" yamllint --version
tool "$G" "Ansible" ansible --version
have searchd && add "$G" "Sphinx Open Source Search Server" "$(dpkg-query -W -f='${Version}' sphinxsearch 2>/dev/null | num)"
have haveged && add "$G" "Haveged" "$(dpkg-query -W -f='${Version}' haveged 2>/dev/null | num)"

# Databases. The version says whether the service runs in the image.
G="Databases"
have psql && add "$G" "PostgreSQL" "$(run psql --version | num)$(service postgresql)"
have mysqld && add "$G" "MySQL" "$(run mysqld --version | num)$(service mysql)"
have redis-server && add "$G" "Redis" "$(run redis-server --version | num)$(service redis-server)"
tool "$G" "SQLite" sqlite3 --version

# Browsers and drivers.
G="Browsers"
tool "$G" "Google Chrome" google-chrome --version
tool "$G" "ChromeDriver" chromedriver --version
tool "$G" "Mozilla Firefox" firefox --version
tool "$G" "Geckodriver" geckodriver --version
if [ -n "${SELENIUM_JAR_PATH:-}" ] && [ -r "$SELENIUM_JAR_PATH" ]; then
  add "$G" "Selenium server" "$(basename "$(readlink -f "$SELENIUM_JAR_PATH")" | num)"
fi
for pkg in /usr/local/lib/node_modules/playwright/package.json /usr/lib/node_modules/playwright/package.json; do
  if [ -r "$pkg" ]; then
    add "$G" "Playwright" "$(jq -r .version "$pkg")"
    break
  fi
done

# Cached tools: what actions/setup-* find without a download.
G="Cached tools"
for entry in "node:Node.js" "Python:Python" "PyPy:PyPy" "go:Go" "Ruby:Ruby" "Java_Temurin-Hotspot_jdk:Java (Temurin)" "CodeQL:CodeQL"; do
  dir="$TOOL_CACHE/${entry%%:*}"
  [ -d "$dir" ] || continue
  vs=$(for d in "$dir"/*/; do
    [ -e "${d%/}/x64.complete" ] && basename "$d"
  done | sort -V | paste -sd, - | sed 's/,/, /g')
  add "$G" "${entry#*:}" "$vs"
done

# apt packages GitHub's ubuntu-24.04 lists (its toolset's apt section), when
# installed here.
G="Installed apt packages"
if have dpkg-query; then
  for p in acl aria2 autoconf automake binutils bison brotli bzip2 coreutils curl \
    dbus dnsutils dpkg dpkg-dev fakeroot file findutils flex fonts-noto-color-emoji \
    ftp g++ gcc gnupg2 haveged iproute2 iputils-ping jq libicu-dev libnss3-tools \
    libsqlite3-dev libssl-dev libtool libyaml-dev locales lz4 m4 make mediainfo \
    mercurial net-tools netcat openssh-client p7zip-full p7zip-rar parallel patchelf \
    pigz pkg-config pollinate python-is-python3 rpm rsync shellcheck sphinxsearch \
    sqlite3 ssh sshpass sudo swig systemd-coredump tar telnet texinfo time tk tree \
    tzdata unzip upx wget xvfb xz-utils zip zsync; do
    # Virtual packages (netcat) resolve to the package that provides them.
    v=$(dpkg-query -W -f='${db:Status-Abbrev}${Version}' "$p" 2>/dev/null | sed -n 's/^ii *//p')
    if [ -z "$v" ] && have apt-cache; then
      for q in $(apt-cache showpkg "$p" 2>/dev/null | awk '/^Reverse Provides:/{f=1; next} f && NF {print $1}'); do
        v=$(dpkg-query -W -f='${db:Status-Abbrev}${Version}' "$q" 2>/dev/null | sed -n 's/^ii *//p')
        [ -n "$v" ] && break
      done
    fi
    add "$G" "$p" "$v"
  done
fi

# Environment worth knowing, when set.
ENV_JSON=$(jq -n '$ENV | with_entries(select(.key | test(
  "^(ImageOS|ImageVersion|ZODE_IMAGE_VERSION|RUNNER_TOOL_CACHE|AGENT_TOOLSDIRECTORY|JAVA_HOME|JAVA_HOME_[0-9]+_X64|GOROOT_[0-9_]+_X64|PLAYWRIGHT_BROWSERS_PATH|CHROME_PATH|CHROMEWEBDRIVER|GECKOWEBDRIVER|EDGEWEBDRIVER|SELENIUM_JAR_PATH|CONDA|VCPKG_INSTALLATION_ROOT|ANDROID_[A-Z_]+|ACCEPT_EULA|XDG_CONFIG_HOME|CARGO_HOME|RUSTUP_HOME|PIPX_HOME|PIPX_BIN_DIR|ANT_HOME|GRADLE_HOME|M2_HOME|POWERSHELL_DISTRIBUTION_CHANNEL)$")))')

MANIFEST=$(jq -Rnc --arg os "$OS" --argjson env "$ENV_JSON" '
  [inputs | split("\t") | select(length == 3) | {g: .[0], n: .[1], v: .[2]}] as $rows
  | ($rows | reduce .[].g as $g ([]; if any(.[]; . == $g) then . else . + [$g] end)) as $order
  | {os: $os,
     groups: [$order[] as $g | {name: $g, items: [$rows[] | select(.g == $g) | {name: .n, version: .v}]}]}
  | if ($env | length) > 0 then .env = $env else . end' <"$ROWS")

printf 'ZODE-MANIFEST %s\n' "$MANIFEST"
ZODE_SOFTWARE_REPORT
chmod 0755 /usr/local/bin/zode-software-report
ZODE_STEP

# Last step: print the software manifest (one ZODE-MANIFEST line).
RUN /usr/local/bin/zode-software-report
